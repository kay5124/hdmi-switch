<Window x:Class="HdmiSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HDMI 監控切換"
        Height="760" Width="920"
        MinHeight="560" MinWidth="760"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, Microsoft JhengHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding SummaryText}" FontSize="13" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding RefreshText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="HDMI 監控切換" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           Text="本機 HDMI 孔能不能偵測到螢幕會即時顯示。螢幕上其他輸入孔有沒有畫面，多數機種無法從這台電腦判斷。"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Outputs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                             Fill="{Binding Signal, Converter={StaticResource SignalBrush}}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="8" Background="#223044" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Connector}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding SignalText}" FontWeight="SemiBold"
                                           Foreground="{Binding Signal, Converter={StaticResource SignalBrush}}"/>

                                <TextBlock Grid.Row="1" Margin="18,8,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                           Text="{Binding PathText}"/>

                                <StackPanel Grid.Row="2" Margin="18,10,0,0">
                                    <TextBlock FontSize="13">
                                        <Run Text="目前輸入：" Foreground="{StaticResource MutedBrush}"/>
                                        <Run Text="{Binding CurrentInputText, Mode=OneWay}"/>
                                        <Run Text="    "/>
                                        <Run Text="{Binding DdcText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                    </TextBlock>
                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Inputs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,8,8" Padding="8,4" CornerRadius="8" Background="#223044">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Fill="{Binding Signal, Converter={StaticResource SignalBrush}}"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="12"/>
                                                        <TextBlock Margin="6,0,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource TrueToVisible}}"
                                                                   Text="使用中"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="讓 Windows 使用此 HDMI"
                                            Visibility="{Binding CanEnableWindowsHdmi, Converter={StaticResource TrueToVisible}}"
                                            Click="EnableWindowsHdmi_OnClick"
                                            Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="切到 HDMI"
                                            IsEnabled="{Binding CanSwitchToHdmi}"
                                            Click="SwitchOne_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Style="{StaticResource PrimaryButton}"
                Content="全部切到 HDMI"
                Click="SwitchAll_OnClick"
                IsEnabled="{Binding CanSwitchAll}"
                Margin="0,12,0,12"
                HorizontalAlignment="Stretch"/>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="紀錄" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Logs}"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,2"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>

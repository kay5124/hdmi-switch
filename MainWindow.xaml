<Window x:Class="HdmiSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mux"
        Height="720" Width="1040"
        MinHeight="560" MinWidth="840"
        Icon="Assets/icon.ico"
        Background="{StaticResource BgBrush}">
    <Grid>
        <Grid Margin="16" Visibility="{Binding IsReady, Converter={StaticResource TrueToVisible}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="88"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Mux" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="點螢幕上的輸入名稱切換該台。琥珀框是這個視窗所在的那一台。"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusChip}" Margin="0,0,8,6"
                        BorderBrush="{StaticResource HereBrush}" BorderThickness="1">
                    <TextBlock FontSize="12">
                        <Run Text="視窗  " Foreground="{StaticResource MutedBrush}"/>
                        <Run Text="{Binding CurrentScreenText, Mode=OneWay}" Foreground="{StaticResource HereBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
                <Border Style="{StaticResource StatusChip}" Margin="0,0,8,6">
                    <TextBlock FontSize="12" Text="{Binding SummaryText}" Foreground="{StaticResource MutedBrush}"/>
                </Border>
                <Border Style="{StaticResource StatusChip}" Margin="0,0,0,6">
                    <TextBlock FontSize="12" Text="{Binding RefreshText}" Foreground="{StaticResource MutedBrush}"/>
                </Border>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DesktopScreens}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8" MinHeight="188" MinWidth="220"
                                    Background="{StaticResource CardBrush}"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Padding="14,12"
                                    SnapsToDevicePixels="True"
                                    ToolTip="{Binding PlaceTitle}"
                                    VerticalAlignment="Stretch"
                                    Cursor="SizeAll"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="ScreenCard_OnPreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ScreenCard_OnPreviewMouseMove"
                                    DragOver="ScreenCard_OnDragOver"
                                    Drop="ScreenCard_OnDrop">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAppHere}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource HereBrush}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.RowSpan="2"
                                               Text="{Binding DisplayNumber}"
                                               FontSize="36" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}"
                                               Opacity="0.92"
                                               VerticalAlignment="Top"
                                               Margin="0,2,10,0"/>

                                    <DockPanel Grid.Column="1" LastChildFill="True">
                                        <WrapPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                            <Border Padding="6,1" CornerRadius="3" Background="#3A2A12" Margin="0,0,0,4"
                                                    Visibility="{Binding IsAppHere, Converter={StaticResource TrueToVisible}}">
                                                <TextBlock Text="視窗" FontSize="10" Foreground="{StaticResource HereBrush}"/>
                                            </Border>
                                            <Border Padding="6,1" CornerRadius="3" Background="#2A2F36" Margin="0,0,0,4"
                                                    Visibility="{Binding IsMouseHere, Converter={StaticResource TrueToVisible}}">
                                                <TextBlock Text="滑鼠" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                        <StackPanel>
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding PlaceLabel}"
                                                       LineHeight="22" LineStackingStrategy="BlockLineHeight"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding Connector, Mode=OneWay}"/>
                                                <Run Text="  ·  "/>
                                                <Run Text="{Binding CurrentInputText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl Grid.Row="1" Grid.Column="1"
                                                  ItemsSource="{Binding Inputs}" Margin="0,10,0,8"
                                                  VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource InputChipButton}"
                                                        Content="{Binding Label}"
                                                        IsEnabled="{Binding CanActivate}"
                                                        Click="SwitchInputChip_OnClick"
                                                        ToolTip="{Binding Hint}"
                                                        AutomationProperties.Name="{Binding Label}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ComboBox Style="{StaticResource DarkComboBox}"
                                                  ItemsSource="{Binding Resolutions}"
                                                  SelectedItem="{Binding SelectedResolution, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Margin="0,0,0,8"
                                                  ToolTip="切換這台螢幕的解析度"
                                                  AutomationProperties.Name="解析度"
                                                  Visibility="{Binding HasResolutions, Converter={StaticResource TrueToVisible}}"
                                                  SelectionChanged="Resolution_OnSelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource GhostButton}" Content="關閉"
                                                    Margin="0,0,6,0"
                                                    IsEnabled="{Binding CanSwitch}"
                                                    ToolTip="用 DDC 讓這台螢幕進入軟關機"
                                                    AutomationProperties.Name="關閉這台螢幕"
                                                    Click="PowerOffOne_OnClick"/>
                                            <Button Style="{StaticResource GhostButton}" Content="識別"
                                                    AutomationProperties.Name="識別這台螢幕"
                                                    Click="IdentifyOne_OnClick"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding OtherOutputs}" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,6"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="使用此 HDMI"
                                    AutomationProperties.Name="讓 Windows 使用此 HDMI 輸出"
                                    Visibility="{Binding CanEnableWindowsHdmi, Converter={StaticResource TrueToVisible}}"
                                    Click="EnableWindowsHdmi_OnClick"/>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Title}"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding PathText}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource GhostButton}" Content="識別全部"
                    AutomationProperties.Name="在所有螢幕顯示編號"
                    Click="IdentifyAll_OnClick" Padding="14,10"/>
            <DockPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock DockPanel.Dock="Left" Text="全部切到"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,0,8,0"/>
                <ItemsControl ItemsSource="{Binding BatchInputOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel VerticalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GhostButton}"
                                    Content="{Binding Label}"
                                    Margin="0,0,8,0"
                                    Padding="14,10"
                                    IsEnabled="{Binding DataContext.CanBatchSwitch, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Click="SwitchAllFamily_OnClick"
                                    AutomationProperties.Name="{Binding Label}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource GhostButton}" Content="全部關閉" Padding="14,10"
                    ToolTip="送出 Windows 系統指令關掉所有螢幕，含這個視窗所在的那台"
                    AutomationProperties.Name="關閉全部螢幕"
                    Click="PowerOffAll_OnClick"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="倒數關閉" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                <ComboBox x:Name="CountdownTarget" Style="{StaticResource DarkComboBox}"
                          Width="150" VerticalAlignment="Center"
                          ItemsSource="{Binding PowerTargets}"
                          AutomationProperties.Name="倒數關閉的目標">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox x:Name="CountdownMinutes" Width="56" Margin="8,0,0,0"
                         Text="30" TextAlignment="Center" VerticalAlignment="Center"
                         AutomationProperties.Name="倒數分鐘數"/>
                <TextBlock Text="分鐘" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,8,0"/>
                <Button Style="{StaticResource GhostButton}" Content="開始"
                        Margin="0,0,6,0" Click="StartCountdown_OnClick"/>
                <Button Style="{StaticResource GhostButton}" Content="取消倒數"
                        Margin="0,0,10,0" Click="CancelCountdown_OnClick"
                        Visibility="{Binding HasCountdown, Converter={StaticResource TrueToVisible}}"/>
                <TextBlock Text="{Binding CountdownText}" VerticalAlignment="Center"
                           Foreground="{StaticResource HereBrush}" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="設定" Padding="14,10"
                    ToolTip="快捷鍵、每天定時關閉、輸入名稱"
                    AutomationProperties.Name="開啟設定"
                    Click="OpenSettings_OnClick"/>
        </Grid>

        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10,8"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="活動" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Logs}"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         Foreground="{StaticResource MutedBrush}"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,1"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
        </Grid>

        <Border Background="{StaticResource BgBrush}"
                Visibility="{Binding IsReady, Converter={StaticResource FalseToVisible}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Mux" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Margin="0,8,0,20" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Text="正在讀取螢幕與輸入來源…"/>
                <ProgressBar Width="240" IsIndeterminate="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

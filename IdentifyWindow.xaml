<Window x:Class="HdmiSwitch.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        IsHitTestVisible="False"
        Focusable="False">
    <Border Background="#D9151C26"
            BorderBrush="#3EE0C5"
            BorderThickness="1"
            CornerRadius="10"
            Padding="20,12">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="NumberText"
                       FontSize="40"
                       FontWeight="Bold"
                       Foreground="#3EE0C5"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="PlaceText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#E8EEF5"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</Window>

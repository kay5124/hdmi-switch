<Window x:Class="HdmiSwitch.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        IsHitTestVisible="False"
        Focusable="False">
    <Border Background="#E61A1D22"
            BorderBrush="#059669"
            BorderThickness="1"
            CornerRadius="4"
            Padding="14,8">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="NumberText"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#F2F4F6"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="PlaceText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#9AA3AD"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
